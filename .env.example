# The API base URL.
#
# There is no mock mode. `VITE_API_MODE` used to select between `src/mock` and a
# live backend; both the flag and the mock driver are gone, and nothing in `src`
# reads it any more — so this app always talks to the real API. If you are
# looking at an older note that mentions `VITE_API_MODE=mock`, it is stale.
#
# Keep this same-origin. `vite.config.js` proxies /api to the backend, which is
# what keeps the httpOnly refresh cookie first-party: pointed straight at
# http://localhost:8080 the cookie is cross-site, so the browser only sends it
# on `SameSite=None; Secure`, which it refuses over plain http — and you get a
# dev setup where signing in works and reloading the page signs you out.
VITE_API_BASE_URL=/api

# Where the proxy sends /api. Defaults to http://localhost:8080, which is the
# backend's own default port. Read by `vite.config.js`, not by the app.
# VITE_API_PROXY=http://localhost:8080

# -- federated sign-in ----------------------------------------------------
#
# Public client ids, not secrets: they appear in this app's own network traffic
# by design. What protects the flow is that each provider only mints a token for
# an origin the application registered, and that the API refuses a token whose
# audience is not us.
#
# These must match GOOGLE_CLIENT_ID / AZURE_AD_CLIENT_ID in the backend's .env,
# or the token the browser gets will not verify. Leave one blank to drop that
# button — though the server's /auth/providers is what actually decides whether
# it renders.
VITE_GOOGLE_CLIENT_ID=
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
